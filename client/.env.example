# Local development:
# VITE_API_BASE_URL=http://localhost:3000

# Current API endpoint for smoke testing.
# Do not commit raw server IPs. Prefer an HTTPS API domain for production,
# for example https://api.monancho.com.
VITE_API_BASE_URL=https://api.monancho.com

# Admin API authentication is entered in the browser at `/admin`.
# Do not set or commit an admin token in Cloudflare Pages build variables.

# Banner is currently disabled in the iframe UI.
# Keep these unset for the current deployment.
# VITE_BANNER_TEXT=
# VITE_BANNER_URL=
# VITE_BANNER_CTA=
