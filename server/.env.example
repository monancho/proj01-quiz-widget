NODE_ENV=development
PORT=3000
DATABASE_PATH=../data/proj01-quiz.sqlite
CORS_ALLOWED_ORIGINS=http://localhost:5173
TISTORY_HOME_URL=https://your-blog.tistory.com

# Optional in local development. Required in production.
# Use a long random value and do not commit the real token.
ADMIN_API_TOKEN=dev-admin-token

# AI Server runs as a separate backend-only service.
# Do not expose this key to the frontend and do not add OPENAI_API_KEY here.
AI_SERVER_BASE_URL=http://localhost:8000
AI_SERVER_API_KEY=replace-with-ai-server-internal-key
AI_SERVER_TIMEOUT_SECONDS=30

BANNER_ENABLED=true
BANNER_IMAGE_URL=https://example.com/banner.png
BANNER_TARGET_URL=https://example.com
BANNER_ALT_TEXT=Quiz banner

