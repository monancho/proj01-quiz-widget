NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/proj01-quiz.sqlite

# Comma-separated origins allowed to call the API.
# Add the Cloudflare Pages production domain and local dev origin only when needed.
CORS_ALLOWED_ORIGINS=https://your-project.pages.dev

TISTORY_HOME_URL=https://your-blog.tistory.com

# Optional iframe banner settings.
BANNER_ENABLED=true
BANNER_IMAGE_URL=https://example.com/banner.png
BANNER_TARGET_URL=https://example.com
BANNER_ALT_TEXT=Quiz banner
