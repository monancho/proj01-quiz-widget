NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/proj01-quiz.sqlite

# Comma-separated origins allowed to call the API.
# The iframe frontend runs from the Cloudflare Pages/custom frontend domain.
CORS_ALLOWED_ORIGINS=https://monancho.com

TISTORY_HOME_URL=https://monancho.tistory.com/

# Required in production. Replace on the OCI server only.
# Do not commit the real value.
ADMIN_API_TOKEN=replace-with-long-random-admin-token

# Backend-only AI Server integration.
# In Docker Compose, use the AI Server service name.
# Do not commit the real key and do not expose it to the frontend.
AI_SERVER_BASE_URL=http://ai-server:8000
AI_SERVER_API_KEY=replace-with-ai-server-internal-key
AI_SERVER_TIMEOUT_SECONDS=30

# Optional iframe banner settings.
# The iframe banner is currently disabled in the frontend.
BANNER_ENABLED=false
BANNER_IMAGE_URL=
BANNER_TARGET_URL=
BANNER_ALT_TEXT=
